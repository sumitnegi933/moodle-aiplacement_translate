{{!
    @template aiplacement_translate/language_modal

    Template to display the language selection modal (shown on first use).

    Context variables required for this template:
    * languages - Array of {value, label, selected} objects

    Example context (json):
    {
        "languages": [
            {"value": "English", "label": "English", "selected": false},
            {"value": "Spanish", "label": "Spanish", "selected": true}
        ]
    }
}}
<div class="ai-translate-language-modal-body">
    <p class="mb-3">{{#str}} selectlanguagemodal, aiplacement_translate {{/str}}</p>
    <div class="form-group">
        <label for="ai-translate-modal-language-select" class="form-label font-weight-bold">
            {{#str}} selectlanguage, aiplacement_translate {{/str}}
        </label>
        <select id="ai-translate-modal-language-select" class="form-control custom-select">
            {{#languages}}
            <option value="{{value}}"{{#selected}} selected{{/selected}}>{{label}}</option>
            {{/languages}}
        </select>
    </div>
    <div class="mt-3 d-flex justify-content-end">
        <button type="button" class="btn btn-secondary mr-2" data-action="translate-modal-cancel">
            {{#str}} cancel, core {{/str}}
        </button>
        <button type="button" class="btn btn-primary" data-action="translate-modal-save">
            {{#str}} saveandtranslate, aiplacement_translate {{/str}}
        </button>
    </div>
</div>
