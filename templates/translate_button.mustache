{{!
    @template aiplacement_translate/translate_button

    Template to display the translate button on the page.

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="ai-translate-page-controls pt-3 pb-3">
    <button class="btn btn-outline-secondary"
            aria-controls="ai-translate-drawer"
            type="button"
            data-action="translate-content"
            data-toggle="tooltip"
            data-html="true"
            data-delay="200"
            title="{{#str}} translate_tooltips, aiplacement_translate {{/str}}"
    >
        <span class="ai-translate-sparkles-icon">
            {{#pix}} sparkles, aiplacement_translate {{/pix}}
        </span>
        <span class="ai-translate-sparkles-icon white">
            {{#pix}} sparkles-white, aiplacement_translate {{/pix}}
        </span>
        {{#str}} translate, aiplacement_translate {{/str}}
    </button>
    {{> core_message/message_jumpto }}
</div>
